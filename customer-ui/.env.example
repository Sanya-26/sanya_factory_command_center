# customer-ui env — prod values get set in Cloudflare Pages dashboard.
# This file documents the shape; do NOT commit a real .env.

# ─── Supabase (factory project) ────────────────────────────────────────
VITE_SUPABASE_URL=https://jzppqxiprjsuvuyulbyj.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...   # anon JWT — safe to ship in client bundle

# ─── 3D Cleo avatar GLB (factory storage / cleo-avatars bucket) ────────
VITE_CLEO_AVATAR_URL=https://jzppqxiprjsuvuyulbyj.supabase.co/storage/v1/object/public/cleo-avatars/cleo-avatar-v5.glb

# ─── Cross-app link: where the factory admin lives ─────────────────────
# Customer-ui sends visitors here when they're trying to sign in as admin.
VITE_FACTORY_URL=https://factoryadmin.aubos.ai

# ─── Brand tokens (for previewing dev-agent emits with a tenant's identity) ─
VITE_BRAND_PRIMARY_COLOR=#3F6E2A
VITE_BRAND_ACCENT_COLOR=#E8DCC1
VITE_BRAND_BG_COLOR=#FAF7F0
VITE_BRAND_TEXT_COLOR=#1F2A1A
VITE_BRAND_PRODUCT_NAME=Drink Gio

# ─── DEV-ONLY (never set these in production Pages env) ────────────────
# These gate the auto-signin shortcut. With VITE_ENABLE_DEV_BYPASS unset
# (or != "1"), the bypass code path is unreachable.
# VITE_ENABLE_DEV_BYPASS=1
# VITE_DEV_CLIENT_EMAIL=...
# VITE_DEV_CLIENT_PASSWORD=...
# VITE_DEV_TEST_EMAIL=...      # used by /onboarding?dev=1 to auto-signin a seed test user
# VITE_DEV_TEST_PASSWORD=...
